# Copy to .env and fill in. .env is git-ignored.

# Postgres. docker compose uses the same values for the db service.
DATABASE_URL=postgres://kommentarwache:kommentarwache@localhost:5432/kommentarwache

# 32+ random bytes, base64. Encrypts connector credentials at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KW_SECRET_KEY=

# Stage 1 decision provider at launch: Jev (TypeSafe). https://console.typesafe.ai/
TYPESAFE_API_KEY=

# Stage 2 text LLM via Ollama. Leave the default when Ollama runs on the same host.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b-it-qat

# Laya (local decision model) once a fine-tuned checkpoint exists. Optional.
LAYA_URL=http://localhost:8000
LAYA_API_KEY=

# Where the dashboard and API are reachable. Used for links and webhooks.
KW_BASE_URL=http://localhost:8080
PORT=8080
